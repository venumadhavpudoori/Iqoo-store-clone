# ───────────────────────────────────────────────
#  iQOO Platform Owner – FastAPI Backend
#  Port: 8000
# ───────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/iqoo_platform

# JWT — MUST match the JWT_SECRET in platform-owner/.env.local
JWT_SECRET=super_secret_jwt_key_change_me_in_production_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# CORS: Next.js dev origin
FRONTEND_ORIGIN=http://localhost:3000

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
S3_BUCKET_NAME=testing
FLOCI_UI_URL=http://localhost:4500/cloud-explorer/aws/storage

# AWS S3 (for post image uploads)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=ap-south-1
AWS_S3_BUCKET=testing
